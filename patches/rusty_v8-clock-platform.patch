+// A DefaultPlatform whose wall clock comes from the embedder: `clock` gets
+// the real time (ms since the epoch) and returns the time to report. This is
+// the clock behind Date, Intl's default "now", and Temporal.Now.
+class ClockPlatform final : public v8::platform::DefaultPlatform {
+ public:
+  ClockPlatform(int thread_pool_size, double (*clock)(double))
+      : v8::platform::DefaultPlatform(thread_pool_size), clock_(clock) {}
+
+  double CurrentClockTimeMillis() override {
+    return clock_(v8::platform::DefaultPlatform::CurrentClockTimeMillis());
+  }
+
+ private:
+  double (*clock_)(double);
+};
+
+v8::Platform* v8__Platform__NewClockPlatform(int thread_pool_size,
+                                             double (*clock)(double)) {
+  return new ClockPlatform(thread_pool_size, clock);
+}
