+  /// The default platform with an embedder-supplied wall clock: `clock`
+  /// gets the real time in milliseconds since the epoch and returns the
+  /// time JavaScript sees (Date, Intl, Temporal.Now). It is called on
+  /// whichever thread asks, and must not unwind.
+  pub fn new_with_clock(
+    thread_pool_size: u32,
+    clock: extern "C" fn(f64) -> f64,
+  ) -> UniqueRef<Self> {
+    unsafe {
+      UniqueRef::from_raw(v8__Platform__NewClockPlatform(
+        thread_pool_size.clamp(1, 16) as i32,
+        clock,
+      ))
+    }
+  }
+
