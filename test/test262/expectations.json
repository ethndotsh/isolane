{
  "test262Commit": "9e61c12835c5e4a3bdba93850427e6742c4f64c4",
  "reasons": {
    "proposal": {
      "category": "draft",
      "reason": "Stage-3 proposals (the \"Proposed language features\" in test262's features.txt), which V8 ships behind flags or not at all; skipped."
    },
    "no-shared-memory": {
      "category": "by-design",
      "reason": "isolane removes SharedArrayBuffer and Atomics (no shared-memory timers for side channels), and with them $262.agent; skipped."
    },
    "no-temporal": {
      "category": "by-design",
      "reason": "Temporal is off (--no-harmony-temporal) until it's audited: it exposes the host time zone. See the roadmap's security section; skipped."
    },
    "no-create-realm": {
      "category": "environment",
      "reason": "$262.createRealm needs a second context in the isolate, which isolane doesn't give a guest. Skipped for feature cross-realm; listed for the tests that call it without the feature."
    },
    "no-host-gc": {
      "category": "environment",
      "reason": "$262.gc: isolane doesn't expose V8's --expose-gc to guests; skipped (feature host-gc-required)."
    },
    "no-is-html-dda": {
      "category": "environment",
      "reason": "$262.IsHTMLDDA (document.all's [[IsHTMLDDA]] slot) needs an embedder object isolane doesn't make; skipped."
    },
    "v8-unshipped": {
      "category": "v8",
      "reason": "Standard features V8 15.2 ships only behind a flag (V8's own test262 run turns it on; isolane runs V8's defaults): joint iteration (Iterator.zip, Iterator.zipKeyed, --js-joint-iteration); skipped."
    },
    "v8-known": {
      "category": "v8",
      "reason": "V8 fails these in d8 too: each is listed as FAIL in V8 15.2's test/test262/test262.status, at the same test262 commit (mostly with-statement and eval scoping corner cases, tail calls, Function.prototype.caller/arguments, Intl data)."
    },
    "no-eval-script": {
      "category": "environment",
      "reason": "$262.evalScript compiles and runs a second Script in the global scope, which a guest can't do from inside a running script (indirect eval scopes let and const differently), and isolane gives tests no host hook for it."
    },
    "dev-allocation": {
      "category": "environment",
      "reason": "Development builds only (rusty_v8's prebuilt V8, no V8 sandbox): a multi-PiB ArrayBuffer length reaches the allocator and the worker dies (out of memory, or a V8 trap). With the V8 sandbox, V8 refuses lengths above the sandbox's maximum with a RangeError first; skipped in development builds."
    },
    "no-script-import": {
      "category": "environment",
      "reason": "import() from a classic script: isolane's scripts (run and eval) have no module graph to import from, so import() rejects there; programs (tenant.load) are modules, and their import() tests run. Skipped for script tests with the dynamic-import feature."
    }
  },
  "skip": {
    "features": {
      "SharedArrayBuffer": "no-shared-memory",
      "Atomics": "no-shared-memory",
      "Atomics.waitAsync": "no-shared-memory",
      "Atomics.pause": "no-shared-memory",
      "Temporal": "no-temporal",
      "cross-realm": "no-create-realm",
      "host-gc-required": "no-host-gc",
      "IsHTMLDDA": "no-is-html-dda",
      "joint-iteration": "v8-unshipped"
    },
    "flags": {
      "CanBlockIsTrue": "no-shared-memory",
      "CanBlockIsFalse": "no-shared-memory"
    },
    "devBuild": {
      "built-ins/ArrayBuffer/allocation-limit.js": "dev-allocation",
      "built-ins/ArrayBuffer/data-allocation-after-object-creation.js": "dev-allocation",
      "built-ins/ArrayBuffer/options-maxbytelength-allocation-limit.js": "dev-allocation",
      "built-ins/TypedArrayConstructors/ctors/object-arg/length-excessive-throws.js": "dev-allocation"
    }
  },
