{
  "name": "isolane",
  "version": "0.0.0",
  "description": "Run untrusted multi-tenant JavaScript in sandboxed V8 worker processes",
  "keywords": [
    "sandbox",
    "v8",
    "isolate",
    "multi-tenant",
    "untrusted",
    "wintertc",
    "seccomp"
  ],
  "homepage": "https://github.com/ethndotsh/isolane#readme",
  "bugs": {
    "url": "https://github.com/ethndotsh/isolane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethndotsh/isolane.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,esnext.disposable --types node test/types-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "postgres": "^3.4.9",
    "typescript": "^5.6.0",
    "zod": "^4.6.7"
  }
}
